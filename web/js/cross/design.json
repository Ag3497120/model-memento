{
  "schema": "memento.stereo-cross-design.v1",
  "note": "立体十字のノード設計。中心はモデル一つ、外に6本の腕。腕の上に、端（問いの言葉＝クエリが当たる所）から中心へ、読む順番どおりに語句のノードを並べる。文は中心の語と、合意した経路の語句をつなげて作る。毎日の AI 記者が更新するのはこの設計（語句・粒度・位置）で、答えそのものは書かない。",
  "subject": {
    "self_cues": ["あなた","君","きみ","お前","自分","you","your","yourself"],
    "self_head": {"wa":"私は","no":"私の"},
    "other_head": {"wa":"{name}は","no":"{name}の"},
    "self_head_en": {"wa":"I ","no":"My ","be":"I am ","was":"I was ","can":"I can "},
    "other_head_en": {"wa":"{name} ","no":"{name}'s ","be":"{name} is ","was":"{name} was ","can":"{name} can "}
  },
  "params": {"decay":0.85,"threshold":0.6,"subject_threshold":0.7,"self_prior":0.75,"both_sides_margin":0.08,"max_rearrange":4},
  "arms": {
    "UP": "何者か",
    "DOWN": "由来と系譜",
    "LEFT": "時間",
    "RIGHT": "能力",
    "FRONT": "使い方",
    "BACK": "性格と限界"
